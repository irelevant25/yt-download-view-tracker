{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug main process",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/electron.cmd",
      "args": [
        ".",
        "--dev"
      ],
      "outputCapture": "std",
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "name": "Run tests",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "program": "${workspaceFolder}/test/api-security.test.js",
      "skipFiles": [
        "<node_internals>/**"
      ]
    }
  ]
}
